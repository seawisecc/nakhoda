# ─────────────────────────────────────────────────────────────────────────
# Nakhoda, contoh konfigurasi. Salin jadi .env.local lalu isi.
#
#   cp .env.example .env.local
#
# Tanpa berkas ini Nakhoda tetap jalan dalam mode lokal: data disimpan di
# browser saja, tidak tersinkron ke perangkat lain.
# ─────────────────────────────────────────────────────────────────────────

# Firebase, dari Console > Project settings > Your apps > Web app.
# Nilai NEXT_PUBLIC_ ikut terkirim ke browser dan memang bukan rahasia; yang
# melindungi data adalah Firebase Auth dan firestore.rules, bukan nilai ini.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Jalur folder repo di laptopmu. Dipakai untuk membangun perintah siap tempel
# di halaman Saran, supaya bisa langsung cd ke folder yang benar.
NEXT_PUBLIC_JALUR_REPO=

# Finnhub, untuk harga saham AS. Gratis di https://finnhub.io/register
# Hanya dibaca di sisi server (src/app/api/harga), tidak pernah ke browser.
# CoinGecko untuk kripto dan ExchangeRate-API untuk kurs tidak butuh kunci.
FINNHUB_API_KEY=

# Service account key Firebase Admin, dipakai scripts/tambah-saran.ts.
# INI RAHASIA SUNGGUHAN: Admin SDK melewati seluruh aturan keamanan.
# Simpan hanya di laptop, di luar folder repo, dan jangan pernah di-commit.
# Ambil dari Console > Project settings > Service accounts > Generate new key.
GOOGLE_APPLICATION_CREDENTIALS=/Users/nama-kamu/rahasia/nakhoda-admin.json
